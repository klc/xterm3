+      canvas.drawRawAtlas(
+          _xcPages[page], t, r, c, BlendMode.modulate, null, _xcAtlasPaint);
+      XC.acc[2]++;
+    }
+    _xcIdx.clear();
+    _xcX.clear();
+    _xcY.clear();
+    _xcC.clear();
+  }
