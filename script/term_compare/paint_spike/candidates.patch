+      final cv = Canvas(rec);
+      final yOff = <double>[];
+      var y = 0.0;
+      for (final img in _xcPages) {
+        yOff.add(y);
+        cv.drawImage(img, Offset(0, y), _xcAtlasPaint);
+        y += img.height;
+      }
+      final pic = rec.endRecording();
+      final merged = pic.toImageSync(w, h);
+      pic.dispose();
+      for (final img in _xcPages) {
+        img.dispose();
+      }
+      _xcPages
+        ..clear()
+        ..add(merged);
+      for (var k = 0; k < _xcSpritePage.length; k++) {
+        _xcSpriteY[k] += yOff[_xcSpritePage[k]];
+        _xcSpritePage[k] = 0;
