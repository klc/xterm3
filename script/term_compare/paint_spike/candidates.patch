+  // Skia-style canonical luminance: sRGB-encoded luma byte, top 3 bits.
+  static int _xcLumBucket(Color c) {
+    final int byte;
+    if (XC.lumMode == 2) {
+      final v = c.toARGB32();
+      byte = (((v >> 16) & 255) * 54 + ((v >> 8) & 255) * 183 + (v & 255) * 19) >> 8;
+    } else {
+      final l = c.computeLuminance();
+      final e = XC.lumMode == 1
+          ? l
+          : (l <= 0.0031308 ? l * 12.92 : 1.055 * pow(l, 1 / 2.4) - 0.055);
+      byte = (e * 255).round().clamp(0, 255);
+    }
+    return byte >> (8 - XC.lumBits);
+  }
+
+  static Color _xcBucketGrey(int b) {
+    final step = 1 << (8 - XC.lumBits);
+    final target = b * step + step ~/ 2; // a grey whose own bucket is b
+    var v = target;
+    if (XC.lumMode == 1) {
+      final l = target / 255;
+      v = ((l <= 0.0031308 ? l * 12.92 : 1.055 * pow(l, 1 / 2.4) - 0.055) * 255)
+          .round();
+    }
+    return Color.fromARGB(255, v, v, v);
+  }
