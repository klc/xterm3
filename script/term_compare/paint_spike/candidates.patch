+// Spike switches and counters (scratch copy only, never in the repo).
+import 'dart:io';
+
+abstract final class XC {
+  static final _e = Platform.environment;
+  static final cacheX = int.parse(_e['XC_CACHEX'] ?? '1'); // A1
+  static final memo = _e['XC_MEMO'] == '1'; // A2: memoised ui styles on a miss
+  static final noFb = _e['XC_NOFB'] == '1'; // A3: short fallback list for ASCII (implies memo)
+  static final fbList = (_e['XC_FBLIST'] ?? 'SF Mono,Menlo').split(',');
+  static final tint = _e['XC_TINT'] == '1'; // B
+  static final atlas = _e['XC_ATLAS'] == '1'; // C
+  static final run = _e['XC_RUN'] == '1'; // D
+  static final runLs = _e['XC_RUNLS'] == '1'; // D with letterSpacing = cell - advance
+  static final runNoDeco = _e['XC_RUNNODECO'] == '1'; // D: decorated cells stay per cell
+  static final lum = _e['XC_LUM'] == '1'; // B/C: glyph keyed by luminance bucket, drawn in that grey
+  static final lshift = double.parse(_e['XC_LSHIFT'] ?? '0'); // D: x shift in units of letterSpacing
+  static final lumMode = int.parse(_e['XC_LUMMODE'] ?? '0'); // 0 sRGB-encoded luma, 1 linear luma, 2 (54r+183g+19b)>>8
+  static final lumBits = int.parse(_e['XC_LUMBITS'] ?? '3');
+  static final atlasCap = int.parse(_e['XC_ATLASCAP'] ?? '8192');
+  static final pages = int.parse(_e['XC_PAGES'] ?? '16');
+  static final distinct = _e['XC_DISTINCT'] == '1';
