+    final rows = (_xcNew.length + cols - 1) ~/ cols;
+    final rec = ui.PictureRecorder();
+    final cv = Canvas(rec);
+    if (XC.lum) {
+      cv.saveLayer(null,
+          Paint()..colorFilter = const ColorFilter.mode(_xcWhite, BlendMode.srcIn));
+    }
+    cv.scale(dpr);
+    final page = _xcPages.length;
+    for (var k = 0; k < _xcNew.length; k++) {
+      final (idx, p) = _xcNew[k];
+      final sx = (k % cols) * _xcSw, sy = (k ~/ cols) * _xcSh;
+      cv.drawParagraph(p, Offset(sx / dpr + _xcPadX, sy / dpr + _xcPadY));
+      while (_xcSpritePage.length <= idx) {
+        _xcSpritePage.add(0);
+        _xcSpriteX.add(0);
+        _xcSpriteY.add(0);
