+  // 3 rejected (no fit / run rejected), 4 atlas rebuilds, 5 sprites (gauge), 6 style memo misses,
+  // 7 paragraph layouts (all paths), 8 tint/atlas ineligible (old path) cells
+  static final acc = List<int>.filled(16, 0);
+  static final keys = <Object>{};
+  static final allKeys = <Object>{};
