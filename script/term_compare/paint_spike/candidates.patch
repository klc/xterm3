+  void _xcFlushAtlas(Canvas canvas) {
+    if (_xcNew.isNotEmpty) _xcRebuildAtlas();
+    final n = _xcIdx.length;
+    XC.acc[5] = _xcSpriteCount;
+    if (n == 0) return;
+    final inv = 1 / _xcAtlasDpr;
+    for (var page = 0; page < _xcPages.length; page++) {
+      var m = 0;
+      for (var k = 0; k < n; k++) {
+        if (_xcSpritePage[_xcIdx[k]] == page) m++;
+      }
+      if (m == 0) continue;
+      final t = Float32List(m * 4), r = Float32List(m * 4), c = Int32List(m);
+      var j = 0;
+      for (var k = 0; k < n; k++) {
+        final idx = _xcIdx[k];
+        if (_xcSpritePage[idx] != page) continue;
+        final sx = _xcSpriteX[idx];
+        final sy = _xcSpriteY[idx];
+        t[4 * j] = inv;
+        t[4 * j + 1] = 0;
+        t[4 * j + 2] = _xcX[k] - _xcPadX;
+        t[4 * j + 3] = _xcY[k] - _xcPadY;
+        r[4 * j] = sx;
+        r[4 * j + 1] = sy;
+        r[4 * j + 2] = sx + _xcSw;
+        r[4 * j + 3] = sy + _xcSh;
+        c[j] = _xcC[k];
+        j++;
