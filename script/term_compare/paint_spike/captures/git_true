[38;2;166;226;46m+[m[38;2;166;226;46mKolonlar:[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m- `full` — `Terminal.write`, 10000 satır scrollback[m
[38;2;166;226;46m+[m[38;2;166;226;46m- `parser` — aynı baytlar `EscapeParser`'dan, hiçbir şey yapmayan handler ile[m
[38;2;166;226;46m+[m[38;2;166;226;46m  (`bin/noop_escape_handler.dart`, 233 üyenin hepsi açıkça uygulanmış;[m
[38;2;166;226;46m+[m[38;2;166;226;46m  `noSuchMethod` **eklenmemeli**, sebebi o dosyanın başlığında)[m
[38;2;166;226;46m+[m[38;2;166;226;46m- `buffer%` — tam yol süresinin parse olmayan kısmı[m
[38;2;166;226;46m+[m[38;2;166;226;46m- `scrollback` — `maxLines: 0` ile `Terminal.write`[m
[38;2;166;226;46m+[m[38;2;166;226;46m- `no-grapheme` — DEC mode 2027 kapalı[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m---[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m## 5. Taban ölçüm[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mM-serisi macOS, MiB/s, üçer koşunun medyanı.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m| workload | full | parser | buffer% | scrollback kapalı | grapheme kapalı |[m
[38;2;166;226;46m+[m[38;2;166;226;46m|---|---|---|---|---|---|[m
[38;2;166;226;46m+[m[38;2;166;226;46m| ascii | 106 | 579 | 82% | 172 | 103 |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| ascii-long-lines | 152 | 922 | 84% | 226 | 149 |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| **sgr** | **81** | **133** | **39%** | 88 | 80 |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| utf8 | 59 | 342 | 82% | 86 | 69 |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| cyrillic | 85 | 364 | 77% | 138 | 85 |[m
