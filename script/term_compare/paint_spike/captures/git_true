[38;2;166;226;46m+[m[38;2;166;226;46m(cd example && flutter build macos --release -t lib/e2e_bench.dart)[m
[38;2;166;226;46m+[m[38;2;166;226;46mscript/term_compare/run_app.sh /tmp/pay /tmp/app 3[m
