[38;2;166;226;46m+[m[38;2;166;226;46m## 4. Ölçüm aracı[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m`bin/parse_bench.dart` — Flutter yok, renderer yok, saf write yolu. 170x50 grid,[m
[38;2;166;226;46m+[m[38;2;166;226;46mworkload başına 32 MiB, 8 KiB chunk (bir PTY okumasının verdiği boyut).[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m```sh[m
[38;2;166;226;46m+[m[38;2;166;226;46mdart compile exe bin/parse_bench.dart -o /tmp/parse_bench && /tmp/parse_bench[m
[38;2;166;226;46m+[m[38;2;166;226;46m```[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mJIT (`dart run`) sayıları ürünle karşılaştırılabilir değil; derleyerek çalıştır.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mKolonlar:[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m- `full` — `Terminal.write`, 10000 satır scrollback[m
[38;2;166;226;46m+[m[38;2;166;226;46m- `parser` — aynı baytlar `EscapeParser`'dan, hiçbir şey yapmayan handler ile[m
[38;2;166;226;46m+[m[38;2;166;226;46m- `buffer%` — tam yol süresinin parse olmayan kısmı[m
[38;2;166;226;46m+[m[38;2;166;226;46m- `scrollback` — `maxLines: 0` ile `Terminal.write`[m
[38;2;166;226;46m+[m[38;2;166;226;46m- `no-grapheme` — DEC mode 2027 kapalı[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m---[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m## 5. Taban ölçüm[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mM-serisi macOS, MiB/s:[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m| workload | full | parser | buffer% | scrollback kapalı | grapheme kapalı |[m
[38;2;166;226;46m+[m[38;2;166;226;46m|---|---|---|---|---|---|[m
[38;2;166;226;46m+[m[38;2;166;226;46m| ascii | 102 | 431 | 76% | 173 | 104 |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| ascii-long-lines | 153 | 825 | 81% | 230 | 147 |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| **sgr** | **76** | **99** | **23%** | 85 | 75 |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| utf8 | 59 | 265 | 78% | 86 | 69 |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| cyrillic | 83 | 296 | 72% | 140 | 83 |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| altscreen | 170 | 234 | 27% | 174 | 174 |[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m### Üç okuma[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m1. **Escape parser çoğu yükte darboğaz değil.** `ascii`'de parser tek başına[m
[38;2;166;226;46m+[m[38;2;166;226;46m   431 MiB/s, tam yol 102. Zamanın %76–81'i buffer yazımında. "Parser yavaş"[m
[38;2;166;226;46m+[m[38;2;166;226;46m   teşhisi bu yükler için yanlış olur.[m
[38;2;166;226;46m+[m[38;2;166;226;46m2. **SGR istisna.** Orada buffer sadece %23 — kalan %77 parser'ın kendisi ve[m
[38;2;166;226;46m+[m[38;2;166;226;46m   76 MiB/s ile en yavaş ikinci yol. Gerçek CLI çıktısı (renkli prompt,[m
[38;2;166;226;46m+[m[38;2;166;226;46m   `ls --color`, build log'ları, `htop`) SGR ağırlıklı olduğu için pratikte en[m
[38;2;166;226;46m+[m[38;2;166;226;46m   çok ödenen yol budur.[m
[38;2;166;226;46m+[m[38;2;166;226;46m3. **Scrollback tutmak pahalı.** Kapatınca ascii 102 → 173 (+%70), cyrillic[m
[38;2;166;226;46m+[m[38;2;166;226;46m   83 → 140 (+%69), utf8 59 → 86 (+%46).[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m---[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m## 6. Bulunan somut nokta — doğrulanmış, çözülmemiş[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m`sgr` payload'ının **%35.8'i** CSI baytı (sayılarak ölçüldü, tahmin değil:[m
[38;2;166;226;46m+[m[38;2;166;226;46m8271 baytın 2963'ü, 308 CSI sekansı).[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mBundan türetilen per-karakter maliyet:[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m| yol | ns/karakter |[m
[38;2;166;226;46m+[m[38;2;166;226;46m|---|---|[m
[38;2;166;226;46m+[m[38;2;166;226;46m| toplu ASCII (`printableTextRunLength` → `writeText`) | **2.2** |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| CSI içi (`ByteConsumer.consume()` başına) | **~23** |[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m*Türetme: ascii parser 431 MiB/s → 2.21 ns/char. sgr parser 99 MiB/s →[m
[38;2;166;226;46m+[m[38;2;166;226;46m10.10 ms/MiB; bunun 673k metin karakteri toplu yoldan 1.49 ms, kalan 8.61 ms[m
[38;2;166;226;46m+[m[38;2;166;226;46m375k CSI karakterine düşüyor → 22.9 ns/char.*[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m**Neden:** `ByteConsumer.consume()` her karakterde `_advancePastConsumedBlocks()`[m
[38;2;166;226;46m+[m[38;2;166;226;46m+ `_decodeCodePoint` + `_codePointCodeUnitLength` + dört alan güncellemesi yapıyor.[m
[38;2;166;226;46m+[m[38;2;166;226;46mBu iş surrogate ve çok-kod-birimli karakterler için var. CSI parametrelerinde ise[m
[38;2;166;226;46m+[m[38;2;166;226;46myalnızca ASCII rakam, `;` ve `:` bulunur — o işin tamamı boşa gidiyor.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mMetin yolunda bu zaten çözülmüş durumda:[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m```dart[m
[38;2;166;226;46m+[m[38;2;166;226;46m// lib/src/utils/byte_consumer.dart[m
[38;2;166;226;46m+[m[38;2;166;226;46mint get printableTextRunLength { ... }      // blok içinde toplu tara[m
[38;2;166;226;46m+[m[38;2;166;226;46mvoid consumeAsciiCodeUnits(int count) { ... } // toplu ilerlet[m
[38;2;166;226;46m+[m[38;2;166;226;46m```[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m`consumeAsciiCodeUnits` `_rollbackAvailable`'ı doğru tutuyor, yani mekanizma[m
[38;2;166;226;46m+[m[38;2;166;226;46mrollback açısından güvenli. **CSI parametre taraması bu çiftin ikizinden yoksun.**[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mBu bir aday, kabul edilmiş çözüm değil.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m---[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m## 7. Denenip REDDEDİLEN — tekrarlanmasın[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m**Fikir:** Scroll'da her satır, öne düşen bir satırı tahliye edip arkaya aynı boyda[m
[38;2;166;226;46m+[m[38;2;166;226;46myenisini allocate ediyor (`buffer.dart` `_newEmptyLine`). Geniş grid'de her biri[m
[38;2;166;226;46m+[m[38;2;166;226;46mbirkaç KiB'lık `Uint32List`. Tahliye edilen depolamayı geri vermek steady state'i[m
[38;2;166;226;46m+[m[38;2;166;226;46mallocation'sız yapmalı. `IndexAwareCircularBuffer`'da `onEvict` hook'u bu iş için[m
[38;2;166;226;46m+[m[38;2;166;226;46mzaten duruyor.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m**Uygulama:** `Buffer`'da serbest liste (derinlik 64), `onEvict`'ten besleniyor,[m
[38;2;166;226;46m+[m[38;2;166;226;46m`_newEmptyLine` aynı genişlikte satır varsa oradan alıyor; `resetForReuse()`[m
[38;2;166;226;46m+[m[38;2;166;226;46m`_data`'yı `fillRange` ile sıfırlıyor. Anchor taşıyan satırlar havuza alınmıyor.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m**Sonuç: ~2 kat yavaş.** Temizlemeyi geçici olarak çıkararak (o hâliyle yanlış,[m
[38;2;166;226;46m+[m[38;2;166;226;46msadece ölçüm için) maliyet ayrıştırıldı:[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m| workload | taban | havuz + `fillRange` | havuz, temizlemesiz |[m
[38;2;166;226;46m+[m[38;2;166;226;46m|---|---|---|---|[m
[38;2;166;226;46m+[m[38;2;166;226;46m| ascii | 102 | 52 | **147** |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| ascii-long-lines | 153 | 77 | **209** |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| sgr | 76 | 57 | 82 |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| utf8 | 59 | 32 | **84** |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| cyrillic | 83 | 42 | **131** |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| altscreen | 170 | 174 | 174 |[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m**Yani havuzlama fikri doğru, temizleme onu öldürüyor.** Geri dönüşümün kendisi[m
[38;2;166;226;46m+[m[38;2;166;226;46mscroll ağırlıklı yüklerde %37–58 kazandırıyor.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m**Kök neden:** Dart'ta taze bir `Uint32List` allocate etmek, mevcut birini[m
[38;2;166;226;46m+[m[38;2;166;226;46mtemizlemekten ucuz. VM taze tipli veriyi işletim sisteminin zaten sıfırladığı[m
[38;2;166;226;46m+[m[38;2;166;226;46msayfalardan veriyor, yani allocation'daki sıfırlama pratikte bedava; `fillRange`[m
[38;2;166;226;46m+[m[38;2;166;226;46mise soğuk ve halihazırda fault'lanmış birkaç KiB'ı gerçekten yazıyor. İki yol da[m
[38;2;166;226;46m+[m[38;2;166;226;46m"aynı kadar sıfırlıyor", maliyetleri aynı değil.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m**Bir daha denenirse** tam temizlemeden kaçınmak şart — örneğin satır başına[m
[38;2;166;226;46m+[m[38;2;166;226;46m"yazılmış en yüksek sütun" işareti tutup yalnızca o aralığı temizlemek. Tipik kısa[m
[38;2;166;226;46m+[m[38;2;166;226;46mshell satırlarında öder, tam genişlik çıktıda ödemez.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mKod `master`'a girmedi, branch silindi.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m**Yan tuzak:** `BufferLine.anchors` her çağrıda `UnmodifiableListView` allocate[m
[38;2;166;226;46m+[m[38;2;166;226;46mediyor. Bu deneyde suçlu değildi (kaldırmak 51 → 52 oynattı, gürültü) ama sıcak[m
[38;2;166;226;46m+[m[38;2;166;226;46mbir yolda allocation yapmayan bir `hasAnchors` gerekir.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m---[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m## 8. Kısıtlar[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m- **Ölçmeden birleştirme yok.** Bu reponun kuralı: Faz 1, 3 ve 5 böyle reddedildi.[m
[38;2;166;226;46m+[m[38;2;166;226;46m  Her değişiklik `parse_bench` ile ölçülüp önce/sonra tablosuyla gelmeli. Negatif[m
[38;2;166;226;46m+[m[38;2;166;226;46m  çıkarsa geri alınıp `RENDER_PLAN.md`'ye kayıt düşülmeli — reddedilen deneyin[m
[38;2;166;226;46m+[m[38;2;166;226;46m  kaydı da bir çıktıdır.[m
[38;2;166;226;46m+[m[38;2;166;226;46m- CSI döngüsünde hassas durum var: `rawLength` / `_maxCsiRawLength` taşma[m
[38;2;166;226;46m+[m[38;2;166;226;46m  kontrolü, yarım kalan sekansta rollback, `_csiOverflowed`. Toplu bir yol[m
[38;2;166;226;46m+[m[38;2;166;226;46m  bunların hepsini birebir korumalı. CSI'ın blok sınırına bölündüğü ve taşma[m
[38;2;166;226;46m+[m[38;2;166;226;46m  sınırına dayandığı vakalar için yeni test şart.[m
[38;2;166;226;46m+[m[38;2;166;226;46m- `dart analyze` sıfır uyarı, `flutter test` tamamen yeşil olmalı.[m
[38;2;166;226;46m+[m[38;2;166;226;46m  Bu brifing yazılırken `master` @ `1537440` üzerinde taban **853 test geçiyor,[m
[38;2;166;226;46m+[m[38;2;166;226;46m  1 atlanıyor** — bir değişiklik bu sayıyı düşürmemeli.[m
[38;2;166;226;46m+[m[38;2;166;226;46m- Ölçüm gürültü bandı, Faz 2'de dört koşuyla belirlendi: **±0.5 ms** (frame[m
[38;2;166;226;46m+[m[38;2;166;226;46m  ölçümleri için). `parse_bench` throughput sayıları daha kararlı ama tek koşuya[m
[38;2;166;226;46m+[m[38;2;166;226;46m  güvenilmemeli.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m---[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m## 9. Açık soru[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m`Terminal.write`'ı, özellikle SGR ağırlıklı çıktıda, nasıl hızlandırırız?[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mBilinen üç açık cephe, hepsi ölçülmüş, hiçbiri çözülmemiş:[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m1. **CSI parametre tarama maliyeti** — karakter başına ~23 ns, toplu metin[m
[38;2;166;226;46m+[m[38;2;166;226;46m   yolunun 10 katı. Bölüm 6.[m
[38;2;166;226;46m+[m[38;2;166;226;46m2. **Buffer yazım yolu** — düz metinde toplam sürenin %76–81'i. Bölüm 5.[m
[38;2;166;226;46m+[m[38;2;166;226;46m   Havuzlama denendi ve reddedildi (bölüm 7); başka yaklaşımlar açık.[m
[38;2;166;226;46m+[m[38;2;166;226;46m3. **Scrollback tutma maliyeti** — %46–70. Bölüm 5. Bunun ne kadarının GC[m
[38;2;166;226;46m+[m[38;2;166;226;46m   promotion baskısı, ne kadarının başka bir şey olduğu ölçülmedi.[m
[38;2;166;226;46m+[m
