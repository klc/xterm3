[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m### Orijinal plan notu[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mFlutter'da kısmi repaint yok: `paint()` çağrıldığında canvas baştan derleniyor. Kaçış yolu,[m
[38;2;166;226;46m+[m[38;2;166;226;46msatırın çizim komutlarını `ui.Picture` olarak kaydedip yeniden oynatmak.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m```[m
[38;2;166;226;46m+[m[38;2;166;226;46mLinePictureCache[m
[38;2;166;226;46m+[m[38;2;166;226;46m  key:   (BufferLine identity, line.revision, cellSize, styleRevision, paletteRevision)[m
[38;2;166;226;46m+[m[38;2;166;226;46m  value: ui.Picture   // (0,0) origin'de kaydedilmiş, tek satır: bg + fg[m
[38;2;166;226;46m+[m[38;2;166;226;46m```[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m`_paintStaticContent` şuna dönüşür:[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m```dart[m
[38;2;166;226;46m+[m[38;2;166;226;46mfor (var i = first; i <= last; i++) {[m
