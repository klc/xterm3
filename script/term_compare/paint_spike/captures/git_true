[38;2;166;226;46m+[m[38;2;166;226;46m## 1. Sorun[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m`Terminal.write` yolu, bir PTY'nin ürettiği hızın altında kalıyor.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mSahadaki görünümü: ShellVibe'da (Flutter uygulaması, xterm3 6.1.3) yerel PTY[m
[38;2;166;226;46m+[m[38;2;166;226;46müzerinde vtebench koşarken pencere donuyor. vtebench 1 MiB'lık örnekleri 11–24 ms'de[m
[38;2;166;226;46m+[m[38;2;166;226;46m"boşaltıldı" diye raporluyor ve tüm koşuyu 2 saniyede bitiriyor; uygulama o sırada[m
[38;2;166;226;46m+[m[38;2;166;226;46myanıt vermiyor ve vtebench çıktıktan **sonra da** bir süre arkadan yetişiyor.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mUygulama tarafında düzeltilemeyeceği doğrulandı. `flutter_pty` çıktıyı bir[m
[38;2;166;226;46m+[m[38;2;166;226;46m`ReceivePort` ile veriyor:[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m```dart[m
[38;2;166;226;46m+[m[38;2;166;226;46mStream<Uint8List> get output => _stdoutPort.cast();[m
[38;2;166;226;46m+[m[38;2;166;226;46m```[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mPTY'yi native bir thread okuyup porta mesaj gönderiyor. Dart tarafında[m
[38;2;166;226;46m+[m[38;2;166;226;46m`subscription.pause()` çağırmak o thread'e ulaşmıyor, yani Dart'tan PTY'ye giden[m
[38;2;166;226;46m+[m[38;2;166;226;46mbir backpressure yolu yok. xterm3'ün kendi `PacedTerminalWriter`'ı da dokümanında[m
[38;2;166;226;46m+[m[38;2;166;226;46mbunu söylüyor: *"There is no back pressure — pending chunks are held until they[m
[38;2;166;226;46m+[m[38;2;166;226;46mcan be parsed."* Üretici tüketiciden hızlı olduğu sürece kuyruk büyüyor, frame[m
[38;2;166;226;46m+[m[38;2;166;226;46mcallback'i PTY mesajlarının arkasında sıra bekliyor.[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46mGeriye tek gerçek kaldıraç kalıyor: **`Terminal.write`'ın kendi hızı.**[m
