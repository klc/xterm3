[38;2;166;226;46m+[m[38;2;166;226;46mdart run script/screenshots/preview.dart example/assets/screenshots/vim.raw[m
[38;2;166;226;46m+[m[38;2;166;226;46m```[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m## Scenes[m
[38;2;166;226;46m+[m
[38;2;166;226;46m+[m[38;2;166;226;46m| recording | image | what it is there to show |[m
[38;2;166;226;46m+[m[38;2;166;226;46m|---|---|---|[m
[38;2;166;226;46m+[m[38;2;166;226;46m| `shell` | `demo-shell.png` | SGR colour, CJK, emoji, combining marks, Cyrillic |[m
[38;2;166;226;46m+[m[38;2;166;226;46m| `htop` | `demo-htop.png` | block elements and meters on the procedural glyph path |[m
